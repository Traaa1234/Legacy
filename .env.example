# === Supabase ===
# From Project Settings → API in your Supabase dashboard
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Personal Access Token from https://supabase.com/dashboard/account/tokens
# Only needed for `npx supabase db push` (migrations) — NOT required for runtime.
# Safe to omit on Vercel.
SUPABASE_ACCESS_TOKEN=sbp_...

# === AI providers ===
# https://platform.openai.com/api-keys (for Whisper)
OPENAI_API_KEY=sk-...
# https://console.anthropic.com/settings/keys (for transcript cleanup)
ANTHROPIC_API_KEY=sk-ant-...

# === Internal ===
# Any random string. Used to authenticate Puppeteer's request to /memoir/print.
PDF_GENERATOR_TOKEN=change-me-to-a-random-string
